  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LibKyrka/LibKyrka.csproj" />
  </ItemGroup>

</Project>
