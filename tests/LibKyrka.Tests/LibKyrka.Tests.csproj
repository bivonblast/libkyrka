<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests run on every supported runtime: .NET 10 and 11 exercise the
    library's net10.0 build, .NET Framework (Windows only) its netstandard2.0
    build. RollForward lets net10.0 run on a newer runtime on machines that
    only have .NET 11 installed; CI installs .NET 10 so it runs on the real one.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(TargetFrameworks);net472</TargetFrameworks>
    <RollForward>Major</RollForward>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The native library is 64-bit only; .NET Framework executables default to 32-bit. -->
  <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LibKyrka/LibKyrka.csproj" />
  </ItemGroup>

</Project>
