<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests run on every supported runtime, .NET 10 and .NET 11.
    RollForward lets net10.0 run on a newer runtime on machines that only
    have .NET 11 installed; CI installs .NET 10 so it runs on the real one.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RollForward>Major</RollForward>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LibKyrka/LibKyrka.csproj" />
  </ItemGroup>

</Project>
